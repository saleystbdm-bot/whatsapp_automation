# ---------------------------------------------------------------------------
# Database (PostgreSQL, provisioned via docker-compose.yml)
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=whatsapp_operations

# ---------------------------------------------------------------------------
# Backend (apps/backend)
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# ---------------------------------------------------------------------------
# Wassenger (used by n8n only — never exposed to the frontend)
# ---------------------------------------------------------------------------
WASSENGER_API_KEY=
WASSENGER_API_BASE_URL=https://api.wassenger.com

# ---------------------------------------------------------------------------
# n8n (used by n8n to authenticate against the backend event endpoints)
# ---------------------------------------------------------------------------
N8N_WEBHOOK_SHARED_SECRET=

# ---------------------------------------------------------------------------
# Business rules
# ---------------------------------------------------------------------------
BUSINESS_TIMEZONE=Asia/Kolkata
EOD_DEADLINE=19:00

# CEO's WhatsApp number (E.164), used for CEO_SLA_ALERT notifications when
# an SLA is missed. Never hard-coded into service code.
CEO_PHONE_NUMBER=+10000000000

# Origin allowed to call the backend API via CORS. Must match the frontend
# dev server's actual origin (Vite's default is http://localhost:5173).
FRONTEND_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Frontend (apps/frontend)
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:3000
